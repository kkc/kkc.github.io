---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import PostRows from '../components/PostRows.astro';
import ProductRows from '../components/ProductRows.astro';
import {allPosts,site} from '../data/site';
const posts=await allPosts();
const featured=['link-time-optimization-note','paper-study-the-tail-at-scale','scheduler-note','golang-race-detector'].map(s=>posts.find(p=>p.data.permalink.includes(s))).filter(Boolean);
---
<Base home>
<section class="author-intro wrap" aria-labelledby="intro-heading">
<div><h1 id="intro-heading">我是 卡西<span>。</span></h1><p>寫程式、研究系統，也打造自己的產品。</p></div>
<div class="intro-links"><a href={site.github}>GitHub</a><a href="/atom.xml">RSS</a></div>
</section>
<div class="home-columns wrap">
<section aria-labelledby="writing-heading"><div class="section-heading"><h2 id="writing-heading">技術文章</h2><a href="/blog/">查看全部<Arrow/></a></div><PostRows posts={featured as typeof posts} compact/></section>
<section aria-labelledby="works-heading"><div class="section-heading"><h2 id="works-heading">作品</h2><a href="/apps/">查看全部<Arrow/></a></div><ProductRows/></section>
</div>

</Base>
