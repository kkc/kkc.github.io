---
import Base from '../../layouts/Base.astro';
import NoteRows from '../../components/NoteRows.astro';
import {publishedNotes, noteTopics} from '../../data/notes';
const notes = await publishedNotes();
const topics = Object.entries(noteTopics).filter(([key]) => notes.some(n => n.data.topics.includes(key as keyof typeof noteTopics)));
---
<Base title="筆記" description="閱讀時弄懂的概念、實作遇到的問題，和還想繼續追下去的線索。Kakashi 持續整理的技術筆記。">
  <header class="wrap page-heading"><p class="eyebrow">NOTES</p><h1>筆記<span>。</span></h1><p>把弄懂的事情記下來，還沒懂的也先留著。</p></header>
  <div class="wrap notes-layout">
    <section aria-label="筆記列表">
      <label class="search-label" for="note-search">搜尋標題、摘要與標籤</label>
      <input id="note-search" class="search" type="search" placeholder="試試 buffering、HPC、測試…" autocomplete="off" />
      <p class="notes-count" aria-live="polite">共 {notes.length} 篇筆記</p>
      <NoteRows notes={notes}/>
      <p id="notes-empty" hidden>沒有符合的筆記。可以換個關鍵字或選擇全部主題。</p>
    </section>
    <aside class="notes-sidebar"><h2>依主題找</h2><nav aria-label="筆記主題"><a href="/notes/" data-note-topic="">全部筆記 <span>{notes.length}</span></a>{topics.map(([key, label]) => <a href={`/notes/?topic=${key}`} data-note-topic={key}>{label}<span>{notes.filter(n => n.data.topics.includes(key as keyof typeof noteTopics)).length}</span></a>)}</nav><p>短一點也沒關係。這裡收的是理解的過程，有新的發現就再補上。</p><a class="notes-blog-link" href="/blog/">閱讀完整文章</a></aside>
  </div>
</Base>
<script>
const input = document.querySelector<HTMLInputElement>('#note-search')!;
const rows = Array.from(document.querySelectorAll<HTMLElement>('.note-row'));
const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-note-topic]'));
const params = new URLSearchParams(location.search);
let topic = params.get('topic') || '';
if (!links.some(link => link.dataset.noteTopic === topic)) topic = '';
function filter() {
  const query = input.value.trim().toLocaleLowerCase();
  let count = 0;
  rows.forEach(row => {
    const show = (!topic || row.dataset.topics?.split(' ').includes(topic)) && (row.dataset.search || '').toLocaleLowerCase().includes(query);
    row.hidden = !show;
    if (show) count++;
  });
  links.forEach(link => {
    if (link.dataset.noteTopic === topic) link.setAttribute('aria-current', 'page');
    else link.removeAttribute('aria-current');
  });
  document.querySelector('.notes-count')!.textContent = `共 ${count} 篇筆記`;
  document.querySelector<HTMLElement>('#notes-empty')!.hidden = count !== 0;
}
links.forEach(link => link.addEventListener('click', event => {
  if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
  event.preventDefault();
  topic = link.dataset.noteTopic || '';
  history.pushState(null, '', topic ? `/notes/?topic=${topic}` : '/notes/');
  filter();
}));
addEventListener('popstate', () => {topic = new URLSearchParams(location.search).get('topic') || ''; filter();});
input.addEventListener('input', filter);
filter();
</script>
